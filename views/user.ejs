<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All Members - LearnHTMLCSSJS.com</title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}
    body{background:#f4f6f8;color:#1e293b;line-height:1.6;padding:15px}
    .wrap{max-width:1100px;margin:0 auto}
    .top{text-align:center;margin:10px 0 20px}
    .top h1{font-size:clamp(24px,5vw,34px);color:#0f172a}
    .top h1 span{background:linear-gradient(90deg,#2563eb,#16a34a);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
    .top p{color:#64748b;font-size:14px;margin-top:4px}
    .top a{display:inline-block;margin-top:10px;background:#0f172a;color:#fff;padding:8px 16px;border-radius:20px;text-decoration:none;font-size:13px;font-weight:bold}
    .top a:hover{background:#2563eb}

    /* Count */
    .count{background:#0f172a;color:#fff;padding:12px 16px;border-radius:12px;text-align:center;margin-bottom:16px;font-size:15px}
    .count b{color:#facc15;font-size:18px}

    /* Users Grid */
    .users{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    .user{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:18px;box-shadow:0 4px 14px rgba(0,0,0,.04);display:flex;gap:12px;align-items:center;overflow:hidden}
    .avatar{width:52px;height:52px;min-width:52px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#16a34a);color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:bold;text-transform:uppercase}
    .user-info{min-width:0;flex:1}
    .user-info h3{font-size:15px;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .user-info p{font-size:13px;color:#64748b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;word-break:break-all}
    .badge{background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0;padding:4px 8px;border-radius:20px;font-size:11px;font-weight:bold;white-space:nowrap}

    /* Empty State */
    .empty{background:#fff;border:2px dashed #cbd5e1;border-radius:14px;padding:40px 20px;text-align:center}
    .empty h3{font-size:22px;color:#0f172a}
    .empty p{color:#64748b;font-size:14px;margin-top:6px}
    .empty a{display:inline-block;margin-top:14px;background:#16a34a;color:#fff;padding:11px 22px;border-radius:10px;text-decoration:none;font-weight:bold}

    /* Tablet - 2 columns */
    @media(max-width:900px){
      .users{grid-template-columns:repeat(2,1fr)}
    }
    /* Mobile - 1 column, full width */
    @media(max-width:600px){
      body{padding:10px}
      .users{grid-template-columns:1fr;gap:10px}
      .user{padding:14px}
      .avatar{width:46px;height:46px;min-width:46px;font-size:19px}
      .user-info h3{font-size:15px}
    }
    /* Very small mobile */
    @media(max-width:360px){
      .user{flex-direction:column;text-align:center}
      .user-info h3,.user-info p{white-space:normal;word-break:break-word}
      .badge{margin-top:2px}
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="top">
      <h1>All <span>Members</span></h1>
      <p>Students learning HTML, CSS & JavaScript on LearnHTMLCSSJS.com</p>
      <a href="/">← Back to Home</a>
    </div>

    <% if(users.length > 0){ %>
      <div class="count">Total Members: <b><%= users.length %></b> 🎓</div>
      <div class="users">
        <% users.forEach(function(user){ %>
          <div class="user">
            <div class="avatar"><%= user.username.charAt(0) %></div>
            <div class="user-info">
              <h3><%= user.username %></h3>
              <p><%= user.email %></p>
            </div>
            <span class="badge">Member</span>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty">
        <h3>😔 NO USER YET</h3>
        <p>No members have joined yet. Be the first to start learning!</p>
        <a href="/signup">Join Now - Free →</a>
      </div>
    <% } %>
  </div>
</body>
</html>