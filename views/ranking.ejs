<body>

<header>
  <p class="breadcrumb"><a href="/">Home</a> &gt; Ranking - Leaderboard</p>
  <h1>🏆 Leaderboard - Ranking</h1>
  <p>See who is on top! Compete with others and become the Topper.</p>
  <p style="margin-top:10px">
    <a href="/">🏠 Home</a> |
    <% if(user){ %>
      <a href="/dashboard">📊 My Dashboard</a> | <a href="/lesson1">📖 Lessons</a> | <a href="/playground">▶ Playground</a> | <a href="/logout">Logout</a>
    <% } else { %>
      <a href="/login">Login</a> | <a href="/signup">Signup</a>
    <% } %>
  </p>
</header>

<div class="container">

  <div class="note"><b>How Ranking Works:</b> Pass a test (80+ marks) to earn points. Your <b>Total Score</b> = Sum of all your test scores. <b>Progress</b> = Lessons Passed / 50. The student with the highest Total Score is Rank 1. <b>🎓 Gold Badge = Certified Web Developer</b> - Passed Final Exam + Got Certificate.</div>

  <% 
    let certifiedCount = (typeof overall !== 'undefined') ? overall.filter(u => u.hasCertificate).length : 0;
  %>
  <% if (certifiedCount > 0) { %>
    <div class="cert-banner">
      <h3 style="margin-bottom:4px">🎓 <%= certifiedCount %> Certified Web Developers on LearnHTMLCSSJS.com!</h3>
      <p>These students passed all 49 lessons + Final Exam and earned their certificate. Will you be next?</p>
    </div>
  <% } %>

  <div class="tabs">
    <button id="overallBtn" class="tab-btn active" onclick="showOverall()">🏆 Overall Ranking</button>
    <button id="lessonBtn" class="tab-btn" onclick="showLesson()">📝 Lesson-wise Ranking</button>
  </div>

  <div id="overallTab">
    <h2 style="margin-bottom:12px">🏆 Overall Ranking - All 50 Lessons</h2>

    <% if(overall.length === 0){ %>
      <div class="empty"><h3>No students yet.</h3><p>Be the first to complete a test and appear on the leaderboard!</p><br><a class="btn btn-green" href="/lesson1">Start Lesson 1 →</a></div>
    <% } else { %>

      <div class="top3">
        <% if(overall[0]){ %>
          <div class="podium gold">
            <div class="medal">🥇</div>
            <h3><%= overall[0].username %></h3>
            <% if(overall[0].hasCertificate){ %><div><span class="badge badge-cert">🎓 Certified - <%= overall[0].certScore %>/100</span></div><% } %>
            <div class="score" style="margin-top:6px"><%= overall[0].totalScore %> Points</div>
            <p><%= overall[0].passed %> / 50 Lessons Passed<br>Avg: <%= overall[0].avg %>/100</p>
          </div>
        <% } %>
        <% if(overall[1]){ %>
          <div class="podium silver">
            <div class="medal">🥈</div>
            <h3><%= overall[1].username %></h3>
            <% if(overall[1].hasCertificate){ %><div><span class="badge badge-cert">🎓 Certified - <%= overall[1].certScore %>/100</span></div><% } %>
            <div class="score" style="margin-top:6px"><%= overall[1].totalScore %> Points</div>
            <p><%= overall[1].passed %> / 50 Lessons Passed<br>Avg: <%= overall[1].avg %>/100</p>
          </div>
        <% } %>
        <% if(overall[2]){ %>
          <div class="podium bronze">
            <div class="medal">🥉</div>
            <h3><%= overall[2].username %></h3>
            <% if(overall[2].hasCertificate){ %><div><span class="badge badge-cert">🎓 Certified - <%= overall[2].certScore %>/100</span></div><% } %>
            <div class="score" style="margin-top:6px"><%= overall[2].totalScore %> Points</div>
            <p><%= overall[2].passed %> / 50 Lessons Passed<br>Avg: <%= overall[2].avg %>/100</p>
          </div>
        <% } %>
      </div>

      <table>
        <tr><th>Rank</th><th>Student</th><th>Lessons Passed</th><th>Tests Given</th><th>Total Score</th><th>Avg Score</th><th>Progress</th></tr>
        <% overall.forEach((u, i) => { %>
          <tr class="<%= user && u.username === user.username ? 'you' : '' %>">
            <td><span class="rank-badge <%= i===0?'rank-1':i===1?'rank-2':i===2?'rank-3':'' %>"><%= i+1 %></span></td>
            <td>
              <%= u.username %>
              <% if(user && u.username === user.username){ %> <span style="color:#16a34a">(You)</span> <% } %>
              <% if(u.hasCertificate){ %><br><span class="badge-cert-small">🎓 Certified - <%= u.certScore %>/100</span><% } %>
            </td>
            <td><b><%= u.passed %> / 50</b></td>
            <td><%= u.attempted %></td>
            <td><b><%= u.totalScore %></b></td>
            <td><%= u.avg %> / 100</td>
            <td style="min-width:120px">
              <%= u.progress %>%
              <div class="bar"><div class="fill" style="width:<%= u.progress %>%"></div></div>
            </td>
          </tr>
        <% }) %>
      </table>
    <% } %>
  </div>

  <div id="lessonTab">
    <h2 style="margin-bottom:12px">📝 Lesson-wise Ranking - Topper of Each Lesson</h2>

    <form class="filter-box" method="GET" action="/ranking">
      <label><b>Select Lesson:</b></label>
      <select name="lesson" onchange="this.form.submit()">
        <option value="All" <%= selectedLesson==='All' ? 'selected' : '' %>>-- Select Lesson --</option>
        <% lessons.forEach(l => { %>
          <option value="<%= l %>" <%= selectedLesson===l ? 'selected' : '' %>><%= l %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn">Show Ranking</button>
    </form>

    <% if(selectedLesson === 'All'){ %>
      <div class="empty">
        <h3>👆 Select a Lesson above</h3>
        <p>Example: Select <b>Lesson 1</b> to see who got the highest marks in Lesson 1.</p>
      </div>
    <% } else if(lessonWise.length === 0){ %>
      <div class="empty">
        <h3>No result for <%= selectedLesson %> yet</h3>
        <p>Be the first to give this test!</p>
        <br>
        <% if(user){ %>
          <a class="btn" href="/lesson1">Go to Lesson</a>
        <% } else { %>
          <a class="btn" href="/login">Login to Give Test</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="top3">
        <% if(lessonWise[0]){ %>
          <div class="podium gold"><div class="medal">🥇</div><h3><%= lessonWise[0].username %></h3><% if(lessonWise[0].hasCertificate){ %><div><span class="badge badge-cert">🎓 Certified</span></div><% } %><div class="score" style="margin-top:6px"><%= lessonWise[0].score %> / 100</div><p><%= selectedLesson %> Topper</p></div>
        <% } %>
        <% if(lessonWise[1]){ %>
          <div class="podium silver"><div class="medal">🥈</div><h3><%= lessonWise[1].username %></h3><% if(lessonWise[1].hasCertificate){ %><div><span class="badge badge-cert">🎓 Certified</span></div><% } %><div class="score" style="margin-top:6px"><%= lessonWise[1].score %> / 100</div><p><%= selectedLesson %></p></div>
        <% } %>
        <% if(lessonWise[2]){ %>
          <div class="podium bronze"><div class="medal">🥉</div><h3><%= lessonWise[2].username %></h3><% if(lessonWise[2].hasCertificate){ %><div><span class="badge badge-cert">🎓 Certified</span></div><% } %><div class="score" style="margin-top:6px"><%= lessonWise[2].score %> / 100</div><p><%= selectedLesson %></p></div>
        <% } %>
      </div>

      <table>
        <tr><th>Rank</th><th>Student</th><th>Lesson</th><th>Score</th><th>Status</th><th>Date</th></tr>
        <% lessonWise.forEach((u, i) => { %>
          <tr class="<%= user && u.username === user.username ? 'you' : '' %>">
            <td><span class="rank-badge <%= i===0?'rank-1':i===1?'rank-2':i===2?'rank-3':'' %>"><%= i+1 %></span></td>
            <td><%= u.username %> <% if(user && u.username === user.username){ %> <span style="color:#16a34a">(You)</span> <% } %> <% if(u.hasCertificate){ %><br><span class="badge-cert-small">🎓 Certified</span><% } %></td>
            <td><%= selectedLesson %></td>
            <td><b><%= u.score %> / 100</b></td>
            <td>
              <% if(u.status === 'Pass'){ %><span class="badge badge-pass">✅ Pass</span><% } else { %><span class="badge badge-fail">❌ Fail</span><% } %>
            </td>
            <td><%= new Date(u.date).toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </table>
    <% } %>
  </div>

</div>

<footer>
  <div class="footer-grid">
    <div>
      <h3>LearnHTMLCSSJS.com</h3>
      <p>Free HTML CSS JS course in simple English. Learn from zero to web developer with 50 lessons, tests, playground and ranking.</p>
