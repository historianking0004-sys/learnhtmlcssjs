<script>
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('lesson') && urlParams.get('lesson') !== 'All') {
    showLesson();
  }
  function showOverall(){
    document.getElementById('overallTab').style.display = 'block';
    document.getElementById('lessonTab').style.display = 'none';
    document.getElementById('overallBtn').classList.add('active');
    document.getElementById('overallBtn').classList.remove('active-green');
    document.getElementById('lessonBtn').classList.remove('active');
    document.getElementById('lessonBtn').classList.remove('active-green');
  }
  function showLesson(){
    document.getElementById('overallTab').style.display = 'none';
    document.getElementById('lessonTab').style.display = 'block';
    document.getElementById('lessonBtn').classList.add('active');
    document.getElementById('lessonBtn').classList.add('active-green');
    document.getElementById('overallBtn').classList.remove('active');
  }
</script>

