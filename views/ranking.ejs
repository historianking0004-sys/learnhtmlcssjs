<style>
  *{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}
  body{background:#f4f6f8;color:#222}
  header{background:#0f172a;color:white;padding:20px;text-align:center;width:100%}
  header a{color:#38bdf8;text-decoration:none;font-size:14px;margin:0 8px}
  .breadcrumb{font-size:13px;color:#94a3b8;margin-bottom:8px}
  .breadcrumb a{color:#38bdf8;text-decoration:none}
  .container{width:100%;max-width:1100px;margin:0 auto;padding:25px 20px}
  .tabs{display:flex;gap:10px;margin-bottom:20px}
  .tab-btn{flex:1;padding:14px;border:none;border-radius:10px;font-size:17px;font-weight:bold;cursor:pointer;background:#e2e8f0;color:#334155}
  .tab-btn.active{background:#0f172a;color:white}
  .tab-btn.active-green{background:#16a34a;color:white}
  #overallTab{display:block}
  #lessonTab{display:none}
  .top3{display:flex;gap:15px;margin-bottom:20px;flex-wrap:wrap}
  .podium{flex:1;min-width:180px;background:white;padding:20px;border-radius:12px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,0.05);position:relative}
  .podium.gold{border:3px solid #facc15}
  .podium.silver{border:3px solid #cbd5e1}
  .podium.bronze{border:3px solid #f59e0b}
  .podium .medal{font-size:40px}
  .podium h3{margin:8px 0 4px;font-size:20px;text-transform:capitalize}
  .podium p{color:#64748b;font-size:14px;line-height:1.6}
  .podium .score{font-size:26px;font-weight:bold;color:#2563eb}
  table{width:100%;background:white;border-collapse:collapse;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.05)}
  th,td{padding:13px;text-align:left;border-bottom:1px solid #e2e8f0}
  th{background:#0f172a;color:white}
  tr.you{background:#dcfce7 !important;font-weight:bold}
  .rank-badge{display:inline-block;width:32px;height:32px;line-height:32px;text-align:center;border-radius:50%;background:#e2e8f0;font-weight:bold}
  .rank-1{background:#facc15}
  .rank-2{background:#e2e8f0}
  .rank-3{background:#f59e0b;color:white}
  .badge{padding:5px 12px;border-radius:20px;font-size:13px;font-weight:bold;white-space:nowrap}
  .badge-pass{background:#dcfce7;color:#166534}
  .badge-fail{background:#fee2e2;color:#991b1b}
  .badge-cert{background:linear-gradient(90deg,#f59e0b,#facc15);color:#0f172a;border:1px solid #f59e0b}
  .badge-cert-small{background:#fef3c7;color:#92400e;border:1px solid #fde68a;padding:3px 8px;border-radius:20px;font-size:11px;font-weight:bold;white-space:nowrap}
  .filter-box{background:white;padding:18px;border-radius:12px;margin-bottom:18px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;box-shadow:0 2px 8px rgba(0,0,0,0.05)}
  .filter-box select{padding:12px;border:1px solid #cbd5e1;border-radius:8px;font-size:16px;flex:1;min-width:180px}
  .btn{background:#2563eb;color:white;padding:12px 20px;border:none;border-radius:8px;font-weight:bold;cursor:pointer;font-size:16px;text-decoration:none;display:inline-block}
  .btn-green{background:#16a34a}
  .empty{text-align:center;padding:30px;background:white;border-radius:12px;color:#64748b}
  .bar{height:10px;background:#e2e8f0;border-radius:20px;overflow:hidden;margin-top:6px}
  .fill{height:100%;background:#16a34a}
  .note{background:#eff6ff;border-left:5px solid #2563eb;padding:12px;border-radius:8px;margin-bottom:18px;line-height:1.7}
  .cert-banner{background:linear-gradient(135deg,#0f172a,#2563eb);color:white;padding:18px;border-radius:12px;margin-bottom:18px;text-align:center}
  .cert-banner p{color:#e2e8f0;font-size:14px}
  footer{background:#0f172a;color:#cbd5e1;padding:35px 30px}
  footer h3{color:white;font-size:20px;margin-bottom:12px}
  footer h4{color:white;font-size:16px;margin:20px 0 10px}
  footer p{font-size:14px;line-height:1.7;color:#94a3b8}
  footer a{color:#38bdf8;text-decoration:none;font-size:14px;line-height:2}
  footer a:hover{color:white;text-decoration:underline}
  .footer-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:25px;max-width:1100px;margin:0 auto}
  .all-lessons{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-top:10px}
  .all-lessons a{background:#1e293b;padding:8px 10px;border-radius:8px;text-align:center;display:block;color:#e2e8f0;font-weight:bold;line-height:1.4}
  .all-lessons a:hover{background:#2563eb;color:white;text-decoration:none}
  .all-lessons a.current{background:#16a34a;color:white}
