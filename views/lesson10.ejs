&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;tr&gt;</span><span class="tag">&lt;td&gt;</span><span class="text">HTML</span><span class="tag">&lt;/td&gt;</span><span class="tag">&lt;td&gt;</span><span class="text">100</span><span class="tag">&lt;/td&gt;</span><span class="tag">&lt;/tr&gt;</span><br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;/table&gt;</span><br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;/section&gt;</span><br><br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;section</span> <span class="attr">id</span>=<span class="val">"contact"</span><span class="tag">&gt;</span><br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;h2&gt;</span><span class="text">Contact Me</span><span class="tag">&lt;/h2&gt;</span><br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;form&gt;</span><br>
