<span class="tag">&lt;!DOCTYPE html&gt;</span><br>
<span class="tag">&lt;html&gt;</span><br>
<span class="tag">&lt;head&gt;</span><br>
&nbsp;&nbsp;<span class="tag">&lt;title&gt;</span><span class="text">Ali - My Portfolio</span><span class="tag">&lt;/title&gt;</span><br>
<span class="tag">&lt;/head&gt;</span><br>
<span class="tag">&lt;body&gt;</span><br><br>
&nbsp;&nbsp;<span class="tag">&lt;header&gt;</span><br>
