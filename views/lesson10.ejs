&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;p&gt;</span><span class="text">I am learning Web Development</span><span class="tag">&lt;/p&gt;</span><br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;img</span> <span class="attr">src</span>=<span class="val">"my-photo.jpg"</span> <span class="attr">width</span>=<span class="val">"120"</span><span class="tag">&gt;</span><br>
&nbsp;&nbsp;<span class="tag">&lt;/header&gt;</span><br><br>
&nbsp;&nbsp;<span class="tag">&lt;nav&gt;</span><br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;a</span> <span class="attr">href</span>=<span class="val">"#about"</span><span class="tag">&gt;</span><span class="text">About</span><span class="tag">&lt;/a&gt;</span> |<br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;a</span> <span class="attr">href</span>=<span class="val">"#skills"</span><span class="tag">&gt;</span><span class="text">Skills</span><span class="tag">&lt;/a&gt;</span> |<br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;a</span> <span class="attr">href</span>=<span class="val">"#contact"</span><span class="tag">&gt;</span><span class="text">Contact</span><span class="tag">&lt;/a&gt;</span><br>
&nbsp;&nbsp;<span class="tag">&lt;/nav&gt;</span><br><br>
&nbsp;&nbsp;<span class="tag">&lt;main&gt;</span><br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;section</span> <span class="attr">id</span>=<span class="val">"about"</span><span class="tag">&gt;</span><br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;h2&gt;</span><span class="text">About Me</span><span class="tag">&lt;/h2&gt;</span><br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;p&gt;</span><span class="text">Hello! My name is Ali. I am a student. I am learning HTML to become a web developer.</span><span class="tag">&lt;/p&gt;</span><br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;/section&gt;</span><br><br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="tag">&lt;section</span> <span class="attr">id</span>=<span class="val">"skills"</span><span class="tag">&gt;</span><br>
