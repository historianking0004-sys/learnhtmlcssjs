        <form id="quizForm">
          <div class="question"><b>Q1. What is DOM?</b><label><input type="radio" name="q1" value="a"> Document Object Model - Page as tree of objects</label><label><input type="radio" name="q1" value="b"> A color</label><label><input type="radio" name="q1" value="c"> A loop</label><label><input type="radio" name="q1" value="d"> A database</label></div>
          <div class="question"><b>Q2. How to select element by id "title"?</b><label><input type="radio" name="q2" value="a"> document.getElementById("title")</label><label><input type="radio" name="q2" value="b"> document.getTitle()</label><label><input type="radio" name="q2" value="c"> getElement("title")</label><label><input type="radio" name="q2" value="d"> document.title</label></div>
          <div class="question"><b>Q3. What does querySelector(".box") do?</b><label><input type="radio" name="q3" value="a"> Selects FIRST element with class box</label><label><input type="radio" name="q3" value="b"> Selects ALL elements with class box</label><label><input type="radio" name="q3" value="c"> Selects element by id</label><label><input type="radio" name="q3" value="d"> Deletes element</label></div>
          <div class="question"><b>Q4. innerHTML vs textContent?</b><label><input type="radio" name="q4" value="a"> innerHTML = Text + HTML tags, textContent = Plain text only</label><label><input type="radio" name="q4" value="b"> Both are same</label><label><input type="radio" name="q4" value="c"> innerHTML = Plain text, textContent = HTML</label><label><input type="radio" name="q4" value="d"> Both delete</label></div>
          <div class="question"><b>Q5. How to change background color in JS?</b><label><input type="radio" name="q5" value="a"> el.style.backgroundColor = "red";</label><label><input type="radio" name="q5" value="b"> el.style.background-color = "red";</label><label><input type="radio" name="q5" value="c"> el.background = "red";</label><label><input type="radio" name="q5" value="d"> el.color = "red";</label></div>
          <div class="question"><b>Q6. How to get input value?</b><label><input type="radio" name="q6" value="a"> document.getElementById("input").value</label><label><input type="radio" name="q6" value="b"> document.getElementById("input").innerHTML</label><label><input type="radio" name="q6" value="c"> document.getElementById("input").text</label><label><input type="radio" name="q6" value="d"> document.getElementById("input").src</label></div>
          <div class="question"><b>Q7. How to hide an element?</b><label><input type="radio" name="q7" value="a"> el.style.display = "none";</label><label><input type="radio" name="q7" value="b"> el.hide();</label><label><input type="radio" name="q7" value="c"> el.display = "hide";</label><label><input type="radio" name="q7" value="d"> el.removeStyle();</label></div>
          <div class="question"><b>Q8. How to create a new element?</b><label><input type="radio" name="q8" value="a"> document.createElement("p") + appendChild()</label><label><input type="radio" name="q8" value="b"> document.newElement("p")</label><label><input type="radio" name="q8" value="c"> document.create("p")</label><label><input type="radio" name="q8" value="d"> document.add("p")</label></div>
