<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Us - Learn HTML CSS JavaScript Free | LearnHTMLCSSJS.com</title>
  <meta name="description" content="Contact LearnHTMLCSSJS.com - Ask questions about HTML, CSS, JavaScript course, certificate, freelancing. Email us at contact@learnhtmlcssjs.com. We reply within 24 hours.">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <style>
    .contact-page{font-family:Arial,sans-serif;max-width:1000px;margin:0 auto;padding:10px;color:#1e293b;line-height:1.7}
    .contact-page h1{font-size:clamp(26px,5vw,36px);text-align:center;color:#0f172a;margin:12px 0 6px}
    .contact-page h1 span{background:linear-gradient(90deg,#2563eb,#16a34a);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
    .contact-page .sub{text-align:center;color:#64748b;font-size:15px;max-width:700px;margin:0 auto 18px}
    .contact-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:14px;align-items:start}
    .contact-card{background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:22px;box-shadow:0 4px 16px rgba(0,0,0,.04)}
    .contact-card h2{margin:0 0 10px;font-size:20px;color:#0f172a}
    .contact-card p{font-size:14.5px;color:#475569;margin:0 0 10px}
    .info-box{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:14px;margin:12px 0;display:flex;gap:10px;align-items:center}
    .info-box b{color:#0f172a;display:block;font-size:15px}
    .info-box span{font-size:13.5px;color:#475569}
    .info-box a{color:#2563eb;font-weight:bold;text-decoration:none;word-break:break-all}
    .info-icon{width:42px;height:42px;flex-shrink:0;background:#dbeafe;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px}
    .email-big{background:#0f172a;color:#fff;border-radius:12px;padding:16px;text-align:center;margin-top:14px}
    .email-big span{display:block;font-size:13px;color:#cbd5e1;margin-bottom:4px}
    .email-big a{color:#facc15;font-size:17px;font-weight:bold;text-decoration:none;word-break:break-all}
    .contact-card label{display:block;font-size:13.5px;font-weight:bold;margin:12px 0 5px;color:#0f172a}
    .contact-card input,.contact-card select,.contact-card textarea{width:100%;padding:12px;border:1px solid #cbd5e1;border-radius:10px;font-size:15px;box-sizing:border-box;font-family:inherit;background:#fff}
    .contact-card textarea{height:110px;resize:vertical}
    .contact-card input:focus,.contact-card textarea:focus{outline:none;border-color:#2563eb;box-shadow:0 0 0 3px #dbeafe}
    .send-btn{width:100%;margin-top:14px;background:#0f172a;color:#fff;border:none;padding:14px;border-radius:12px;font-size:16px;font-weight:bold;cursor:pointer}
    .send-btn:hover{background:#2563eb}
    .success{background:#dcfce7;color:#166534;padding:12px;border-radius:10px;font-size:14px;margin-bottom:10px;text-align:center;font-weight:bold}
    .error{background:#fee2e2;color:#991b1b;padding:12px;border-radius:10px;font-size:14px;margin-bottom:10px;text-align:center}
    .small{font-size:12.5px;color:#94a3b8;text-align:center;margin-top:10px}
    .faq-link{margin-top:14px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:12px;font-size:13.5px;color:#166534}
    .faq-link a{color:#15803d;font-weight:bold}
    @media(max-width:700px){.contact-grid{grid-template-columns:1fr}.contact-card{padding:16px}}
  </style>
</head>
<body>

<header style="text-align:center;padding:15px">
  <h1 style="margin:0"><a href="/" style="text-decoration:none"><span style="color:#e34c26">LearnHTML</span><span style="color:#264de4">CSS</span><span style="color:#f0db4f;background:#323330;padding:0 8px;border-radius:8px">JS</span><span style="color:#64748b;font-size:.5em">.com</span></a></h1>
  <p style="color:#475569;margin:5px 0">Learn HTML, CSS & JavaScript - Free Web Development Course</p>
</header>

<main class="contact-page">
  <h1>Contact Us - <span>We Reply Within 24 Hours</span></h1>
  <p class="sub">Have a question about the course, certificate, test, or freelancing? Fill the form below or email us directly. We read every message.</p>

  <div class="contact-grid">
    <!-- LEFT - INFO -->
    <div class="contact-card">
      <h2>📩 Get In Touch</h2>
      <p>We personally read and reply to every message. Most replies are sent on the same day.</p>

      <div class="info-box">
        <div class="info-icon">✉️</div>
        <div><b>Email Us</b><span><a href="mailto:contact@learnhtmlcssjs.com">contact@learnhtmlcssjs.com</a></span></div>
      </div>
      <div class="info-box">
        <div class="info-icon">⏰</div>
        <div><b>Reply Time</b><span>Within 24 Hours - Monday to Sunday</span></div>
      </div>
      <div class="info-box">
        <div class="info-icon">📍</div>
        <div><b>Location</b><span> Punjab, Pakistan - Online Worldwide</span></div>
      </div>

      <div class="email-big">
        <span>Prefer to email directly?</span>
        <a href="mailto:contact@learnhtmlcssjs.com">contact@learnhtmlcssjs.com</a>
      </div>

      <div class="faq-link">
        <b>Before you message:</b> Check our <a href="/faq">FAQ Page</a> - Your question about login, test, or certificate may already be answered there.
      </div>
    </div>

    <!-- RIGHT - FORM -->
    <div class="contact-card">
      <h2>📝 Send Message</h2>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="success">✅ Message sent successfully! We will reply to your email soon.</div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error">❌ <%= error %></div>
      <% } %>

      <form action="/contact" method="POST">
        <label>Your Name *</label>
        <input type="text" name="name" placeholder="e.g. Ali Khan" required>

        <label>Your Email *</label>
        <input type="email" name="email" placeholder="e.g. you@gmail.com" required>

        <label>Topic</label>
        <select name="topic">
          <option value="Course Question">Course Question</option>
          <option value="Certificate Problem">Certificate Problem</option>
          <option value="Test / Login Problem">Test / Login Problem</option>
          <option value="Freelancing Help">Freelancing Help</option>
          <option value="Business / Partnership">Business / Partnership</option>
          <option value="Other">Other</option>
        </select>

        <label>Message *</label>
        <textarea name="message" placeholder="Write your question here..." required></textarea>

        <button class="send-btn" type="submit">Send Message →</button>
        <p class="small">When you submit this form, your message will be sent to our email <b>contact@learnhtmlcssjs.com</b></p>
      </form>
    </div>
  </div>
</main>

<footer style="text-align:center;padding:15px;color:#64748b;font-size:13px">© 2026 LearnHTMLCSSJS.com | <a href="/about">About</a> | <a href="/contact">Contact</a> | <a href="/privacy-policy">Privacy</a></footer>
</body>
</html>