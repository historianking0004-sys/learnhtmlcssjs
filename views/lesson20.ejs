<span class="tag">.btn-white</span> <span class="text">{</span> <span class="attr">background</span><span class="text">:</span> <span class="val">white</span><span class="text">;</span> <span class="attr">color</span><span class="text">:</span> <span class="val">#2563eb</span><span class="text">;</span> <span class="attr">padding</span><span class="text">:</span> <span class="val">12px 25px</span><span class="text">;</span> <span class="attr">border</span><span class="text">:</span> <span class="val">none</span><span class="text">;</span> <span class="attr">border-radius</span><span class="text">:</span> <span class="val">8px</span><span class="text">;</span> <span class="attr">font-weight</span><span class="text">:</span> <span class="val">bold</span><span class="text">;</span> <span class="attr">cursor</span><span class="text">:</span> <span class="val">pointer</span><span class="text">;</span> <span class="text">}</span><br><br>
<span class="comment" style="color:#94a3b8">/* ===== 3. CARDS ===== */</span><br>
<span class="tag">.cards</span> <span class="text">{</span> <span class="attr">display</span><span class="text">:</span> <span class="val">flex</span><span class="text">;</span> <span class="attr">gap</span><span class="text">:</span> <span class="val">15px</span><span class="text">;</span> <span class="attr">margin-top</span><span class="text">:</span> <span class="val">15px</span><span class="text">;</span> <span class="text">}</span><br>
<span class="tag">.card</span> <span class="text">{</span> <span class="attr">flex</span><span class="text">:</span> <span class="val">1</span><span class="text">;</span> <span class="attr">background</span><span class="text">:</span> <span class="val">white</span><span class="text">;</span> <span class="attr">padding</span><span class="text">:</span> <span class="val">20px</span><span class="text">;</span> <span class="attr">border-radius</span><span class="text">:</span> <span class="val">12px</span><span class="text">;</span> <span class="attr">text-align</span><span class="text">:</span> <span class="val">center</span><span class="text">;</span> <span class="attr">border</span><span class="text">:</span> <span class="val">1px solid #e2e8f0</span><span class="text">;</span> <span class="attr">transition</span><span class="text">:</span> <span class="val">0.3s</span><span class="text">;</span> <span class="text">}</span><br>
<span class="tag">.card:hover</span> <span class="text">{</span> <span class="attr">transform</span><span class="text">:</span> <span class="val">translateY(-5px)</span><span class="text">;</span> <span class="attr">box-shadow</span><span class="text">:</span> <span class="val">0 10px 20px rgba(0,0,0,0.1)</span><span class="text">;</span> <span class="text">}</span><br>
<span class="tag">.card button</span> <span class="text">{</span> <span class="attr">background</span><span class="text">:</span> <span class="val">#2563eb</span><span class="text">;</span> <span class="attr">color</span><span class="text">:</span> <span class="val">white</span><span class="text">;</span> <span class="attr">padding</span><span class="text">:</span> <span class="val">10px 20px</span><span class="text">;</span> <span class="attr">border</span><span class="text">:</span> <span class="val">none</span><span class="text">;</span> <span class="attr">border-radius</span><span class="text">:</span> <span class="val">8px</span><span class="text">;</span> <span class="attr">cursor</span><span class="text">:</span> <span class="val">pointer</span><span class="text">;</span> <span class="attr">width</span><span class="text">:</span> <span class="val">100%</span><span class="text">;</span> <span class="attr">margin-top</span><span class="text">:</span> <span class="val">10px</span><span class="text">;</span> <span class="text">}</span><br><br>
<span class="comment" style="color:#94a3b8">/* ===== 4. CONTACT + 5. FOOTER ===== */</span><br>
<span class="tag">.contact</span> <span class="text">{</span> <span class="attr">background</span><span class="text">:</span> <span class="val">white</span><span class="text">;</span> <span class="attr">padding</span><span class="text">:</span> <span class="val">20px</span><span class="text">;</span> <span class="attr">border-radius</span><span class="text">:</span> <span class="val">12px</span><span class="text">;</span> <span class="attr">margin-top</span><span class="text">:</span> <span class="val">15px</span><span class="text">;</span> <span class="text">}</span><br>
<span class="tag">.contact input</span> <span class="text">{</span> <span class="attr">width</span><span class="text">:</span> <span class="val">100%</span><span class="text">;</span> <span class="attr">padding</span><span class="text">:</span> <span class="val">12px</span><span class="text">;</span> <span class="attr">border</span><span class="text">:</span> <span class="val">2px solid #e2e8f0</span><span class="text">;</span> <span class="attr">border-radius</span><span class="text">:</span> <span class="val">8px</span><span class="text">;</span> <span class="attr">margin</span><span class="text">:</span> <span class="val">8px 0</span><span class="text">;</span> <span class="attr">outline</span><span class="text">:</span> <span class="val">none</span><span class="text">;</span> <span class="text">}</span><br>
<span class="tag">.contact input:focus</span> <span class="text">{</span> <span class="attr">border-color</span><span class="text">:</span> <span class="val">#2563eb</span><span class="text">;</span> <span class="text">}</span><br>
<span class="tag">.footer</span> <span class="text">{</span> <span class="attr">background</span><span class="text">:</span> <span class="val">#0f172a</span><span class="text">;</span> <span class="attr">color</span><span class="text">:</span> <span class="val">white</span><span class="text">;</span> <span class="attr">text-align</span><span class="text">:</span> <span class="val">center</span><span class="text">;</span> <span class="attr">padding</span><span class="text">:</span> <span class="val">15px</span><span class="text">;</span> <span class="attr">border-radius</span><span class="text">:</span> <span class="val">10px</span><span class="text">;</span> <span class="attr">margin-top</span><span class="text">:</span> <span class="val">15px</span><span class="text">;</span> <span class="text">}</span><br><br>
<span class="comment" style="color:#94a3b8">/* ===== 6. RESPONSIVE ===== */</span><br>
<span class="tag">@media</span> <span class="text">(</span><span class="attr">max-width</span><span class="text">:</span> <span class="val">700px</span><span class="text">)</span> <span class="text">{</span><br>
&nbsp;&nbsp;<span class="tag">.cards</span> <span class="text">{</span> <span class="attr">flex-direction</span><span class="text">:</span> <span class="val">column</span><span class="text">;</span> <span class="text">}</span><br>
&nbsp;&nbsp;<span class="tag">.navbar</span> <span class="text">{</span> <span class="attr">flex-direction</span><span class="text">:</span> <span class="val">column</span><span class="text">;</span> <span class="attr">gap</span><span class="text">:</span> <span class="val">10px</span><span class="text">;</span> <span class="text">}</span><br>
&nbsp;&nbsp;<span class="tag">.hero h1</span> <span class="text">{</span> <span class="attr">font-size</span><span class="text">:</span> <span class="val">24px</span><span class="text">;</span> <span class="text">}</span><br>
<span class="text">}</span>
    </code></div>
    <h2>6. Pro Tips - Make It Even Better</h2>
    <p>1. <b>Card Hover:</b> .card:hover { transform: translateY(-5px); } - Card lifts up on hover. Try it in demo above.<br>2. <b>Image:</b> Add &lt;img&gt; inside card with width: 100%; border-radius: 8px;<br>3. <b>Badge:</b> Add "50% OFF" badge with background: #dc2626; color: white; padding: 5px 10px; border-radius: 20px;<br>4. <b>Price:</b> Show old price with text-decoration: line-through; + new price in blue.</p>
    <h2>7. Homework - Build Your Own Shop</h2>
    <p>In Playground, build this full project:</p>
    <p>1. Change shop name to <b>YOUR name</b> - e.g. "Ali's Shop"<br>2. Change 3 products to <b>your favourite products</b> - e.g. Mobile, Laptop, Headphones<br>3. Change prices to <b>your prices</b><br>4. Add <b>one more card</b> - total 4 cards<br>5. Test on <b>Mobile</b> - open on your phone, cards should stack</p>
