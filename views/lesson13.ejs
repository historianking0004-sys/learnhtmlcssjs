      <div id="quizArea">
        <form id="quizForm">
          <div class="question"><b>Q1. Which property changes Size of text?</b><label><input type="radio" name="q1" value="a"> font-size</label><label><input type="radio" name="q1" value="b"> font-family</label><label><input type="radio" name="q1" value="c"> font-weight</label><label><input type="radio" name="q1" value="d"> text-size</label></div>
          <div class="question"><b>Q2. Which property changes Font / Style of text?</b><label><input type="radio" name="q2" value="a"> font-size</label><label><input type="radio" name="q2" value="b"> font-family</label><label><input type="radio" name="q2" value="c"> text-align</label><label><input type="radio" name="q2" value="d"> line-height</label></div>
          <div class="question"><b>Q3. Which property makes text Bold?</b><label><input type="radio" name="q3" value="a"> font-weight: bold;</label><label><input type="radio" name="q3" value="b"> font-size: bold;</label><label><input type="radio" name="q3" value="c"> text-align: bold;</label><label><input type="radio" name="q3" value="d"> font-style: bold;</label></div>
          <div class="question"><b>Q4. Which property moves text to Center?</b><label><input type="radio" name="q4" value="a"> text-align: center;</label><label><input type="radio" name="q4" value="b"> font-align: center;</label><label><input type="radio" name="q4" value="c"> align: center;</label><label><input type="radio" name="q4" value="d"> text-center: yes;</label></div>
          <div class="question"><b>Q5. Which property controls Gap between Lines?</b><label><input type="radio" name="q5" value="a"> letter-spacing</label><label><input type="radio" name="q5" value="b"> line-height</label><label><input type="radio" name="q5" value="c"> word-spacing</label><label><input type="radio" name="q5" value="d"> text-gap</label></div>
