<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup - TammanTools</title>
    <style>
        *{ margin:0; padding:0; box-sizing:border-box; font-family: Arial, sans-serif; }
        body{ min-height:100vh; display:flex; align-items:center; justify-content:center; background:#f3f4f6; padding:20px; }
        .box{ background:#fff; width:100%; max-width:380px; padding:30px 25px; border-radius:14px; box-shadow:0 10px 30px rgba(0,0,0,0.1); text-align:center; }
        .box h1{ font-size:26px; margin-bottom:5px; }
        .box p{ color:#666; font-size:14px; margin-bottom:20px; }
        form{ display:flex; flex-direction:column; gap:12px; text-align:left; }
        label{ font-size:13px; font-weight:bold; }
        input{ width:100%; padding:12px; border:1px solid #ddd; border-radius:8px; font-size:15px; outline:none; }
        input:focus{ border-color:#111827; }
        .btn{ background:#111827; color:#fff; border:none; padding:13px; border-radius:8px; font-size:16px; font-weight:bold; cursor:pointer; margin-top:5px; }
        .btn:hover{ background:#000; }
        .links{ margin-top:18px; font-size:14px; }
        .links a{ color:#111827; font-weight:bold; text-decoration:none; }
        .links a:hover{ text-decoration:underline; }
    </style>
</head>
<body>
    <div class="box">
        <h1>Create Account</h1>
        <p>Signup to continue to TammanTools</p>

        <form action="/signup" method="post">
            <label>Username</label>
            <input type="text" name="username" placeholder="Enter username" required>

            <label>Email</label>
            <input type="email" name="email" placeholder="Enter email" required>

            <label>Password</label>
            <input type="password" name="password" placeholder="Enter password" required>

            <input type="submit" value="Signup" class="btn">
        </form>

        <div class="links">
            Already have an account? <a href="/login">Login</a>
            <br><br>
            <a href="/">← Back to Home</a>
        </div>
    </div>
</body>
</html>