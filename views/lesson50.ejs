<script>
// ===== GUEST TEST HANDLER - For Lesson 50, Guest cannot take exam =====
const IS_LOGGED_IN = <%= (typeof user !== 'undefined' && user) ? 'true' : 'false' %>;
function saveTestResult(lessonName, score, testStatus, onSaved) {
  if (!IS_LOGGED_IN) { if (onSaved) onSaved(null); return; }
  fetch('/save-result', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ lesson: lessonName, score: score, status: testStatus }) })
  .then(r => r.json())
  .then(data => { if (onSaved) onSaved(data); })
  .catch(() => { if (onSaved) onSaved(null); });
}
// ===== GUEST HANDLER END =====
const CAN_TAKE_EXAM = <%= (typeof canTakeExam !== 'undefined' && canTakeExam) ? 'true' : 'false' %>;
function updateCertName(){let n=document.getElementById('studentName'); if(!n) return; let v=n.value.trim(); if(v){document.getElementById('certName').innerText=v;}}
let testRunning=false;let timerInterval=null;let timeLeft=600;
function showLesson(){if(testRunning){alert("🔒 Exam is running! Please submit the exam first. All tabs are locked.");return;}document.getElementById('lessonContent').style.display='block';document.getElementById('testContent').style.display='none';document.getElementById('lessonTabBtn').classList.add('active');document.getElementById('lessonTabBtn').classList.remove('test-active');let tb=document.getElementById('testTabBtn'); if(tb){tb.classList.remove('active');tb.classList.remove('test-active');} window.scrollTo({top:0,behavior:'smooth'});}
function showTest(){
  if(!CAN_TAKE_EXAM){
    if(!IS_LOGGED_IN){alert("🔒 Please Login First to take Final Exam.");window.location.href="/login";return;}
    alert("🔒 Final Exam is locked! Complete Lesson 1-49 with 80%+ first.");return;
  }
  document.getElementById('lessonContent').style.display='none';document.getElementById('testContent').style.display='block';let tb=document.getElementById('testTabBtn'); if(tb){tb.classList.add('active');tb.classList.add('test-active');} document.getElementById('lessonTabBtn').classList.remove('active');window.scrollTo({top:0,behavior:'smooth'});}
function lockTabs(){testRunning=true;document.getElementById('lessonTabBtn').classList.add('disabled');document.getElementById('lockMsg').style.display='block';let h=document.getElementById('homeLink'); if(h) h.classList.add('disabled');}
function unlockTabs(){testRunning=false;clearInterval(timerInterval);document.getElementById('lessonTabBtn').classList.remove('disabled');document.getElementById('lockMsg').style.display='none';let h=document.getElementById('homeLink'); if(h) h.classList.remove('disabled');let t=document.getElementById('timerBar'); if(t) t.style.display='none';}
function startTest(){if(!CAN_TAKE_EXAM){alert("🔒 Final Exam is locked!");return;} document.getElementById('startScreen').style.display='none';document.getElementById('quizArea').style.display='block';document.getElementById('timerBar').style.display='block';document.getElementById('scoreBox').style.display='none';lockTabs();timeLeft=600;updateTimer();timerInterval=setInterval(function(){timeLeft--;updateTimer();if(timeLeft<=0){clearInterval(timerInterval);alert("⏰ Time Up! Your exam is auto-submitted.");checkTest(true);}},1000);}
function updateTimer(){let m=Math.floor(timeLeft/60);let s=timeLeft%60;let el=document.getElementById('timerText'); if(el) el.innerText=(m<10?"0"+m:m)+":"+(s<10?"0"+s:s);if(timeLeft<=60){let tb=document.getElementById('timerBar'); if(tb) tb.classList.add('warning');}}
function checkTest(isAuto){
  if(!CAN_TAKE_EXAM){
    if(!IS_LOGGED_IN){alert("🔒 Please Login First to take Final Exam.");window.location.href="/login";return;}
    alert("🔒 You cannot take Final Exam. Complete Lesson 1-49 with 80%+ first.");return;
  }
  let answers={q1:'a',q2:'a',q3:'a',q4:'a',q5:'a',q6:'a',q7:'a',q8:'a',q9:'a',q10:'a',q11:'a',q12:'a',q13:'a',q14:'a',q15:'a',q16:'a',q17:'a',q18:'a',q19:'a',q20:'a'};
  let score=0;let attempted=0;
  for(let q in answers){let selected=document.querySelector('input[name="'+q+'"]:checked');if(selected){attempted++;if(selected.value===answers[q])score+=5;}}
  if(!isAuto && attempted<20){alert("Please answer all 20 questions! You have answered only "+attempted+" questions.");return;}
  unlockTabs();
  let testStatus=score>=80?'Pass':'Fail';
  saveTestResult('Lesson 50 - Final Exam', score, testStatus, function(data){
    if (data && data.certificateId) {
      let cid = data.certificateId;
      let certIdEl=document.getElementById('certId'); if(certIdEl) certIdEl.innerText=cid;
      let verifyLine=document.getElementById('verifyLine'); if(verifyLine) verifyLine.style.display='block';
      let verifyLink=document.getElementById('verifyLink'); if(verifyLink) verifyLink.href='/verify/'+cid;
      let verifyIdText=document.getElementById('verifyIdText'); if(verifyIdText) verifyIdText.innerText=cid;
      let newCert=document.getElementById('newCertIdText'); if(newCert) newCert.innerText=cid;
      let newVerify=document.getElementById('newVerifyLink'); if(newVerify) newVerify.href='/verify/'+cid;
    }
    showResult(score,testStatus);
  });
}
window.finalAnswers = answers;
showResult(score, testStatus);
function showResult(score,testStatus){
  // 1. Show Green = Correct, Red = Your Wrong Answer (if answers are available)
  // This works if your checkTest() saved answers in window.finalAnswers
  // Example in checkTest: window.finalAnswers = answers;
  if(window.finalAnswers){
    let answers = window.finalAnswers;
    document.querySelectorAll('.question label').forEach(function(l){
      l.classList.remove('correct-answer','wrong-answer');
    });
    for(let q in answers){
      let selected = document.querySelector('input[name="'+q+'"]:checked');
      let correctValue = answers[q];
      let correctInput = document.querySelector('input[name="'+q+'"][value="'+correctValue+'"]');
      if(correctInput){
        correctInput.parentElement.classList.add('correct-answer');
      }
      if(selected && selected.value !== correctValue){
        selected.parentElement.classList.add('wrong-answer');
      }
    }
  }

  let box=document.getElementById('scoreBox');let scoreText=document.getElementById('scoreText');let scoreMsg=document.getElementById('scoreMsg');let certSuccess=document.getElementById('certSuccess');
  if(!box) return;
  box.style.display='block';scoreText.innerText="Your Final Score: "+score+" / 100";
  if(score>=80){
    box.className='pass';
    let grade=score>=95?"A+ - Outstanding!":score>=90?"A - Excellent!":score>=85?"B+ - Very Good!":"B - Good!";
    scoreMsg.innerText="🎉 CONGRATULATIONS! You PASSED Final Exam! You are now a Certified Web Developer! Scroll up - Green = Correct, Red = Your Wrong Answer.";
    let cs=document.getElementById('certScore'); if(cs) cs.innerText=score+" / 100";
    let cg=document.getElementById('certGrade'); if(cg) cg.innerText=grade;
    let today=new Date();let cd=document.getElementById('certDate'); if(cd) cd.innerText=today.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});
    if(certSuccess) certSuccess.style.display='block';
  }else{
    box.className='fail';
    scoreMsg.innerText="😔 You FAILED. Passing marks are 80. You got "+score+". Scroll up - Green answers are correct, Red answers were your wrong answers. Do not give up! Read lessons again and try again. You are close!";
    if(certSuccess) certSuccess.style.display='none';
  }
  box.scrollIntoView({behavior:'smooth'});
}
function resetTest(){clearInterval(timerInterval);testRunning=false;let f=document.getElementById('quizForm'); if(f) f.reset();let sb=document.getElementById('scoreBox'); if(sb) sb.style.display='none';let qa=document.getElementById('quizArea'); if(qa) qa.style.display='none';let ss=document.getElementById('startScreen'); if(ss) ss.style.display='block';let tb=document.getElementById('timerBar'); if(tb) tb.style.display='none';unlockTabs();}
</script>
