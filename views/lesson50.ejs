<style>
  *{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}
  body{background:#f4f6f8;color:#222}
  header{background:#0f172a;color:white;padding:20px;text-align:center;width:100%}
  header a{color:#38bdf8;text-decoration:none;font-size:14px}
  header a.disabled{color:#64748b;pointer-events:none}
  .container{width:100%;max-width:100%;margin:0 auto;background:white;padding:30px 40px}
  h1{font-size:28px;margin-bottom:10px;line-height:1.3}
  h2{margin:20px 0 10px;color:#0f172a}
  p{line-height:1.7;margin-bottom:12px}
  .note{background:#eff6ff;border-left:5px solid #2563eb;padding:12px;border-radius:8px;margin:15px 0}
  .btn{display:inline-block;background:#16a34a;color:white;padding:10px 18px;border-radius:8px;text-decoration:none;font-weight:bold;margin-top:10px;border:none;cursor:pointer;font-size:16px}
  .btn-next{background:#2563eb}
  .btn-prev{background:#64748b}
  .btn-locked{background:#dc2626!important;cursor:not-allowed}
  .nav{display:flex;justify-content:space-between;margin-top:25px;flex-wrap:wrap;gap:10px}
  .box{background:#e0f2fe;padding:10px;border-radius:8px;margin-top:10px;line-height:1.8}
  .tabs{display:flex;gap:10px;margin-bottom:20px;position:sticky;top:0;background:white;padding:10px 0;z-index:10;border-bottom:2px solid #e2e8f0}
  .tab-btn{flex:1;padding:14px;border:none;border-radius:10px;font-size:17px;font-weight:bold;cursor:pointer;background:#e2e8f0;color:#334155}
  .tab-btn.active{background:#0f172a;color:white}
  .tab-btn.test-active{background:#16a34a;color:white}
  .tab-btn.disabled{opacity:0.6;pointer-events:none;cursor:not-allowed}
  #lessonContent{display:block}
  #testContent{display:none}
  .test-box{border:2px solid #0f172a;border-radius:12px;padding:20px;background:#f8fafc}
  .test-info{background:#fef3c7;padding:12px;border-radius:8px;margin-bottom:15px;line-height:1.7}
  .question{background:white;padding:15px;border-radius:10px;margin-bottom:12px;border:1px solid #e2e8f0}
  .question b{display:block;margin-bottom:8px}
  .question label{display:block;padding:8px 10px;margin:4px 0;background:#f1f5f9;border-radius:7px;cursor:pointer}
  .question label:hover{background:#e0f2fe}
  .question input{margin-right:8px}
  #scoreBox{display:none;padding:20px;border-radius:10px;text-align:center;margin-top:15px}
  #scoreBox.pass{background:#dcfce7;border:2px solid #16a34a}
  #scoreBox.fail{background:#fee2e2;border:2px solid #dc2626}
  #scoreBox h3{font-size:26px;margin-bottom:5px}
  #startScreen{text-align:center;padding:30px 10px}
  #timerBar{display:none;position:sticky;top:60px;z-index:20;background:#dc2626;color:white;padding:12px 15px;border-radius:10px;font-weight:bold;font-size:18px;text-align:center;margin-bottom:15px}
  #timerBar.warning{background:#ea580c}
  #quizArea{display:none}
  .lock-msg{background:#fee2e2;color:#991b1b;padding:10px;border-radius:8px;margin-bottom:12px;text-align:center;font-weight:bold;display:none}
  .locked-box{background:#fee2e2;border:2px solid #dc2626;border-radius:14px;padding:24px;text-align:center;margin:16px 0}
  .locked-box h2{color:#991b1b}
  .locked-box p{color:#7f1d1d}
  .locked-box .btn{margin:6px}
  table{width:100%;border-collapse:collapse;margin:10px 0;background:white}
  th,td{border:1px solid #e2e8f0;padding:10px;text-align:left}
  th{background:#0f172a;color:white}
  .breadcrumb{font-size:13px;color:#94a3b8;margin-bottom:8px}
  .breadcrumb a{color:#38bdf8;text-decoration:none}
  .demo-card{background:white;border:1px solid #e2e8f0;border-radius:12px;padding:20px;text-align:center;margin-top:12px}
  .demo-input{width:100%;padding:12px;border:2px solid #e2e8f0;border-radius:8px;font-size:15px;outline:none;margin:6px 0}
  .demo-input:focus{border-color:#2563eb;box-shadow:0 0 0 3px #dbeafe}
  .cert{border:6px double #f59e0b;border-radius:16px;padding:28px 20px;text-align:center;background:linear-gradient(180deg,#fffbeb,#ffffff);max-width:620px;margin:16px auto}
  .cert h2{font-size:28px;margin:6px 0;color:#0f172a}
  .cert-name{font-size:32px;font-weight:bold;color:#2563eb;border-bottom:2px solid #e2e8f0;display:inline-block;padding:0 20px 6px;margin:10px 0}
  .cert-badge{font-size:48px}
  .verify-line{font-size:12px;color:#64748b;margin-top:10px}
  .verify-line a{color:#2563eb;font-weight:bold}
  .journey{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;margin:12px 0}
  .journey div{background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px;text-align:center;font-size:13px}
  .journey b{display:block;font-size:20px}
  footer{background:#0f172a;color:#cbd5e1;padding:35px 30px}
  footer h3{color:white;font-size:20px;margin-bottom:12px}
  footer h4{color:white;font-size:16px;margin:20px 0 10px}
  footer p{font-size:14px;line-height:1.7;color:#94a3b8}
  footer a{color:#38bdf8;text-decoration:none;font-size:14px;line-height:2}
  footer a:hover{color:white;text-decoration:underline}
  .footer-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:25px;max-width:1100px;margin:0 auto}
  .all-lessons{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-top:10px}
  .all-lessons a{background:#1e293b;padding:8px 10px;border-radius:8px;text-align:center;display:block;color:#e2e8f0;font-weight:bold;line-height:1.4}
  .all-lessons a:hover{background:#2563eb;color:white;text-decoration:none}
 
 /* ===== TEST RESULT COLORS ===== */
.question label.correct-answer{
  background:#dcfce7 !important;
  border:2px solid #16a34a !important;
  color:#166534;
  font-weight:bold;
}
.question label.wrong-answer{
  background:#fee2e2 !important;
  border:2px solid #dc2626 !important;
  color:#991b1b;
}
.question label.correct-answer::after{
  content:"  ✓ Correct";
  color:#16a34a;
}
.question label.wrong-answer::after{
  content:"  ✗ Your Answer - Wrong";
  color:#dc2626;
} .all-lessons a.current{background:#16a34a;color:white}
  .footer-bottom{text-align:center;border-top:1px solid #1e293b;margin-top:25px;padding-top:15px;font-size:13px;color:#64748b}
  @media(max-width:700px){.footer-grid{grid-template-columns:1fr}.all-lessons{grid-template-columns:1fr 1fr}.container{padding:20px}.journey{grid-template-columns:1fr 1fr}}
  @media print{header,.tabs,#testContent,.nav,footer,.no-print{display:none !important}.container{padding:0}.cert{border:6px double #f59e0b;max-width:100%}}
