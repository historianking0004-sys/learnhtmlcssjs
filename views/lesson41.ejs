    <h2>4. 3 JS Features Every Website Needs</h2>
    <table>
      <tr><th>Feature</th><th>Code Idea</th><th>Why?</th></tr>
      <tr><td>Mobile Menu</td><td>Button toggles menu - classList.toggle("show")</td><td>On mobile, links hide, hamburger shows</td></tr>
      <tr><td>Dark Mode</td><td>Button toggles body class + save in LocalStorage</td><td>Users love it, looks professional</td></tr>
      <tr><td>Contact Form Check</td><td>If name === "" or message === "" show error, else show success</td><td>Stops empty messages, like Lesson 32</td></tr>
      <tr><td>Smooth Scroll</td><td>CSS: html { scroll-behavior: smooth; }</td><td>Clicking menu link scrolls nicely, not jump</td></tr>
      <tr><td>Back to Top</td><td>Button + window.scrollTo({top: 0, behavior: "smooth"})</td><td>Long page, easy to go up</td></tr>
    </table>
    <div class="code-box"><code>
<span class="comment" style="color:#94a3b8">// Dark Mode - Save in LocalStorage, remember next time</span><br>
<span class="text">function toggleTheme() {</span><br>
&nbsp;&nbsp;<span class="text">document.body.classList.toggle("dark");</span><br>
&nbsp;&nbsp;<span class="text">let isDark = document.body.classList.contains("dark");</span><br>
&nbsp;&nbsp;<span class="text">localStorage.setItem("theme", isDark ? "dark" : "light");</span><br>
<span class="text">}</span><br>
<span class="comment" style="color:#94a3b8">// On page load - Read saved theme</span><br>
<span class="text">if (localStorage.getItem("theme") === "dark") {</span><br>
&nbsp;&nbsp;<span class="text">document.body.classList.add("dark");</span><br>
<span class="text">}</span><br><br>
<span class="comment" style="color:#94a3b8">// Mobile Menu</span><br>
<span class="text">function toggleMenu() {</span><br>
&nbsp;&nbsp;<span class="text">document.getElementById("navLinks").classList.toggle("show");</span><br>
<span class="text">}</span>
    </code></div>
