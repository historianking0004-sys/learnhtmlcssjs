  #tab3 .dash-btn small{display:block;font-weight:normal;font-size:12.5px;color:#cbd5e1;margin-top:2px}
  #tab3 .links{text-align:center;margin-top:12px;font-size:13.5px}
  #tab3 .links a{color:#2563eb;font-weight:bold;text-decoration:none;margin:0 6px}
  #tab3 .guest-box{background:linear-gradient(135deg,#0f172a,#2563eb);color:white;border-radius:16px;padding:20px;text-align:center}
  #tab3 .guest-box h3{color:white;margin:0}
  #tab3 .guest-box p{color:#e2e8f0;margin:6px 0 0;font-size:14px}
  #tab3 .guest-box a{display:inline-block;margin-top:12px;background:#facc15;color:#0f172a;padding:11px 22px;border-radius:10px;text-decoration:none;font-weight:bold}
  @media(max-width:600px){#tab3 .mini-stats{grid-template-columns:repeat(3,1fr);gap:6px}#tab3 .mini{padding:10px 4px}#tab3 .mini b{font-size:16px}#tab3 .perf{padding:16px}}
</style>

<div class="tab tab3" id="tab3">
  <h2>Your Overall Performance - <span>At a Glance</span></h2>
  <p class="sub">Simple progress bar. Full details in your Dashboard.</p>
  <% if (user) { %>
    <% 
      let completed = typeof completedLessons !== 'undefined' ? completedLessons : 0;
      let total = 50;
      let pct = Math.round((completed / total) * 100);
      let totalScore = typeof userTotalScore !== 'undefined' ? userTotalScore : 0;
      let avg = typeof avgScore !== 'undefined' ? avgScore : 0;
      let next = completed + 1; if(next > 50) next = 50;
    %>
    <div class="perf">
      <div class="perf-top">
        <div><h3>👋 Hi <%= user.username %>!</h3><p>You completed <b style="color:#0f172a"><%= completed %> / 50 Lessons</b> • Next: Lesson <%= next %></p></div>
        <div class="big-pct"><%= pct %>%<small>Complete</small></div>
      </div>
      <div class="bar"><div class="bar-fill" id="overallBar" style="width:<%= pct %>%"><%= pct > 10 ? pct + '%' : '' %></div></div>
      <div class="bar-info"><span>Start</span><span><%= pct %>% Done</span><span>Certificate 🎓</span></div>
      <div class="mini-stats">
        <div class="mini"><b><%= completed %> / 50</b><span>Lessons Done</span></div>
        <div class="mini"><b><%= totalScore %></b><span>Total Marks</span></div>
        <div class="mini"><b><%= avg %>%</b><span>Average Score</span></div>
      </div>
      <a class="dash-btn" href="/dashboard">📊 See Full Progress in Dashboard →<small>All test scores, lesson-wise details, ranking & certificate</small></a>
      <div class="links"><a href="/lesson<%= next %>">Continue Lesson <%= next %> →</a> | <a href="/ranking">🏆 Ranking</a> | <a href="/playground">▶ Playground</a></div>
    </div>
  <% } else { %>
    <div class="guest-box">
      <h3>👋 Hi Guest - Track Your Progress</h3>
      <p>Create free account to save progress & see your performance bar here.</p>
      <a href="/signup">✨ Create Free Account</a>
      <p style="font-size:12.5px;margin-top:10px">Already have account? <a href="/login" style="color:white;font-weight:bold">Login →</a></p>
    </div>
    <div class="perf" style="margin-top:12px;opacity:.9">
      <div class="perf-top"><div><h3>Your Overall Performance</h3><p>Login to see your real progress.</p></div><div class="big-pct">0%<small>Complete</small></div></div>
      <div class="bar"><div class="bar-fill" style="width:0%"></div></div>
      <div class="bar-info"><span>Start</span><span>0% Done</span><span>Certificate 🎓</span></div>
      <a class="dash-btn" href="/lesson1">▶ Start Lesson 1 - Free<small>No account needed to start learning</small></a>
    </div>
  <% } %>
</div>
<script>
  window.addEventListener('load', function(){
    var b = document.getElementById('overallBar');
    if(b){ var w = b.style.width; b.style.width='0%'; setTimeout(()=>{ b.style.width=w; },200); }
  });
</script>
        </div>
